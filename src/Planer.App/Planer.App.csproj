<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Planer_App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <Version>1.4.1</Version>
    <Product>Планер</Product>
    <Description>Персональный планер задач, привычек и платежей</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Planer.Core/Planer.Core.csproj" />
    <ProjectReference Include="../Planer.Data/Planer.Data.csproj" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <Target Name="PinNetRuntimeForStandalonePublish" BeforeTargets="ProcessFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="10.0.13" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeWinUIResourcesInPublish" AfterTargets="ComputeFilesToPublish">
    <!-- The unpackaged WinUI build generates these resources after content discovery. -->
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI application resource index was not generated." />
    <ItemGroup>
      <_PlanerWinUIResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_PlanerWinUIResource)">
        <RelativePath>%(_PlanerWinUIResource.RecursiveDir)%(_PlanerWinUIResource.Filename)%(_PlanerWinUIResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
