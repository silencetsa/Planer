<Window x:Class="Planer_App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Планер">
  <Grid RequestedTheme="Light" Background="#F5F5F5">
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="Планер" FontFamily="{StaticResource ContentControlThemeFontFamily}" Background="#F5F5F5" Foreground="#99908C">
      <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico"/></TitleBar.IconSource>
    </TitleBar>
    <Frame x:Name="RootFrame" Grid.Row="1" />
  </Grid>
</Window>
