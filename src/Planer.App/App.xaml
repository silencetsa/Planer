<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Planer_App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Planer_App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HelveticaNeue-Roman.otf#Helvetica Neue</FontFamily>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="CharacterSpacing" Value="25" />
                <Setter Property="Foreground" Value="#99908C" />
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="CharacterSpacing" Value="25" />
                <Setter Property="Foreground" Value="#99908C" />
            </Style>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="CharacterSpacing" Value="25" />
                <Setter Property="Foreground" Value="#99908C" />
            </Style>
            <Style TargetType="CalendarDatePicker" BasedOn="{StaticResource DefaultCalendarDatePicker}">
                <Setter Property="CharacterSpacing" Value="25" />
                <Setter Property="Foreground" Value="#99908C" />
            </Style>
            <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
                <Setter Property="CharacterSpacing" Value="25" />
                <Setter Property="Foreground" Value="#99908C" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
